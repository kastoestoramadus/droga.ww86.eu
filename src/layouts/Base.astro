---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import languages from "@/config/language.json";
import theme from "@/config/theme.json";
import { isPreviewBuild, stripBase, withBase } from "@/lib/basePath";
import { getSinglePage } from "@/lib/contentParser.astro";
import { autodiscoveryLink } from "@/lib/drogaFeed";
import {
  alternateLinks,
  canonicalUrl,
  resolveOgImage,
  type PostSlugIndex,
  type SiteUrlConfig,
} from "@/lib/drogaSharingMetadata";
import { getLangFromUrl, getTranslations } from "@/lib/utils/languageParser";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Announcement from "./helpers/Announcement";
import SearchModal from "./helpers/SearchModal";

// font families - extract font names for Font component (filter out type keys)
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  lang?: string;
}

// destructure frontmatter
const { title, meta_title, description, image, noindex, canonical, lang } =
  Astro.props;

const language = lang || getLangFromUrl(Astro.url);
const { skip_to_content } = await getTranslations(language);

// every page of a preview build is non-indexable, whatever the page set itself
const effectiveNoindex = noindex || isPreviewBuild();

const siteUrl: SiteUrlConfig = {
  baseUrl: config.site.base_url,
  basePath: config.site.base_path,
  defaultLanguage: config.settings.default_language,
  defaultLanguageInSubdir: config.settings.default_language_in_subdir,
  trailingSlash: config.site.trailing_slash,
};

// In a preview build the served pathname carries the preview prefix; sharing
// metadata always addresses the production location of the same page.
const pagePath = stripBase(Astro.url.pathname);

// Post slugs per language keyed by translationKey; alternates pair through it,
// never through a URL prefix swap (slugs differ between languages).
const disabledLanguages = config.settings.disable_languages as string[];
const enabledLanguages = languages
  .map(({ languageCode }) => languageCode)
  .filter((code) => !disabledLanguages.includes(code));

const slugIndex: PostSlugIndex = {};
const postsByLang = new Map(
  await Promise.all(
    enabledLanguages.map(
      async (code) => [code, await getSinglePage("blog", code)] as const,
    ),
  ),
);
for (const [code, posts] of postsByLang) {
  slugIndex[code] = Object.fromEntries(
    posts
      .filter((post) => post.data.translationKey)
      .map((post) => [post.data.translationKey!, post.id.split("/").pop()!]),
  );
}

const canonicalHref = canonical ?? canonicalUrl(siteUrl, pagePath);
const alternates = alternateLinks(
  siteUrl,
  pagePath,
  enabledLanguages,
  slugIndex,
);

// Feed autodiscovery for the page's own language (/rss.xml, /en/rss.xml).
const feedLink = autodiscoveryLink(siteUrl, language, config.site.title);

// Article metadata only when the rendered route is a post; dates and author
// names come from the post frontmatter unchanged.
const routeSlug = decodeURI(pagePath).split("/").filter(Boolean).pop();
const currentPost = postsByLang.get(language)?.find(
  (post) => post.id.split("/").pop() === routeSlug,
);
const isPost = Boolean(currentPost && currentPost.data.translationKey);
const ogImage = resolveOgImage(image, config.metadata.meta_image, siteUrl);
---

<!doctype html>
<html lang={language}>
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    <!-- favicon -->
    <link rel="shortcut icon" href={withBase(config.site.favicon)} />
    <!-- theme meta -->
    <meta name="theme-name" content="astroplate" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css - Astro 6 built-in Font API -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={canonicalHref} item-prop="url" />

    <!-- language alternates -->
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }

    <!-- rss autodiscovery -->
    {
      feedLink && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={feedLink.title}
          href={feedLink.href}
        />
      )
    }

    <!-- noindex robots -->
    {effectiveNoindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content={isPost ? "article" : "website"} />
    {
      isPost && currentPost?.data.date && (
        <meta
          property="article:published_time"
          content={currentPost.data.date.toISOString()}
        />
      )
    }
    {
      isPost && currentPost?.data.author && (
        <meta property="article:author" content={plainify(currentPost.data.author)} />
      )
    }
    <!-- og:url keeps the production URL even in a preview build: the preview prefix
         is an isolated copy, not a second address of the article -->
    <meta property="og:url" content={canonicalHref} />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- twitter-image -->
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex flex-col min-h-screen">
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }

    <a href="#main-content" class="skip-link">{skip_to_content}</a>
    <Announcement lang={language} client:only="react" />
    <Header />
    <SearchModal lang={language} client:only="react" />
    <main class="grow focus:outline-none" id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <TwSizeIndicator />
    <script>
      // Print fallback for engines without ::details-content (see droga-reading.css): open every closed
      // optional section for the print job and restore the reader's state afterwards.
      const openedForPrint = new Set<HTMLDetailsElement>();
      window.addEventListener("beforeprint", () => {
        document.querySelectorAll<HTMLDetailsElement>("details:not([open])").forEach((d) => {
          d.open = true;
          openedForPrint.add(d);
        });
      });
      window.addEventListener("afterprint", () => {
        openedForPrint.forEach((d) => {
          d.open = false;
        });
        openedForPrint.clear();
      });
    </script>
  </body>
</html>
