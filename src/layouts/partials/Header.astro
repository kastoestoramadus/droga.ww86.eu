---
import languages from "@/config/language.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import Logo from "@/components/Logo.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import config from "@/config/config.json";
import LanguageSwitcher from "@/helpers/LanguageSwitcher";
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
} from "@/lib/utils/languageParser";

import { IoSearch } from "react-icons/io5";

let lang = getLangFromUrl(Astro.url);
const menu = await getTranslations(lang);

const { navigation_button, settings } = config;
const { default_language } = config.settings;
const { pathname } = Astro.url;
const { get_started, menu_label } = await getTranslations(lang);

// Post slugs differ between languages; use the shared key rather than swapping URL prefixes.
let translationPaths: Record<string, string> = {};
if (/\/blog\/[^/]+\/?$/.test(pathname)) {
  const slug = decodeURI(pathname).split("/").filter(Boolean).pop();
  const currentPost = (await getSinglePage("blog", lang)).find(
    (post) => post.id.split("/").pop() === slug,
  );
  if (currentPost?.data.translationKey) {
    translationPaths = Object.fromEntries(
      await Promise.all(languages.map(async ({ languageCode }) => {
        const paired = (await getSinglePage("blog", languageCode)).find(
          (post) => post.data.translationKey === currentPost.data.translationKey,
        );
        return [languageCode, paired
          ? slugSelector(`/blog/${paired.id.split("/").pop()}`, languageCode)
          : slugSelector("/blog", languageCode)];
      })),
    );
  }
}

const disabledLanguages = config.settings.disable_languages as string[];
if (disabledLanguages.includes(lang)) {
  lang = default_language;
}
---

<header class={`header z-30 ${settings.sticky_header && "sticky top-0"}`}>
  <nav class="navbar container">
    {/* logo */}
    <div class="order-0">
      <Logo />
    </div>
    {/* navbar toggler: a real button, so the keyboard reaches it; state in aria-expanded */}
    <button
      id="nav-toggle"
      type="button"
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label={menu_label}
      class="order-3 cursor-pointer flex items-center lg:hidden text-text-dark dark:text-white lg:order-1"
    >
      <svg id="show-button" class="h-6 fill-current block" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
      <svg id="hide-button" class="h-6 fill-current hidden" viewBox="0 0 20 20" aria-hidden="true">
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
    </button>
    {/* /navbar toggler */}

    <ul
      id="nav-menu"
      class="navbar-nav order-3 hidden w-full pb-6 lg:order-1 lg:flex lg:w-auto lg:space-x-2 lg:pb-0 xl:space-x-8"
    >
      {
        menu?.main.map((menu: any) => (
          <>
            {menu.hasChildren ? (
              <li class="nav-item nav-dropdown group relative">
                <button
                  type="button"
                  id={`submenu-${menu.name}`}
                  aria-expanded="false"
                  aria-controls={`submenu-list-${menu.name}`}
                  data-submenu-toggle
                  class={`nav-link inline-flex items-center ${
                    menu.children
                      ?.map(({ url }: { url: string }) =>
                        slugSelector(url, lang),
                      )
                      .includes(pathname)
                      ? "active"
                      : ""
                  }`}
                >
                  {menu.name}
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                  </svg>
                </button>
                <ul id={`submenu-list-${menu.name}`} class="nav-dropdown-list hidden lg:invisible lg:absolute lg:block lg:opacity-0">
                  {menu.children?.map((child: any) => (
                    <li class="nav-dropdown-item">
                      <a
                        href={slugSelector(child.url, lang)}
                        aria-label={child.name}
                        class={`nav-dropdown-link block ${
                          pathname === slugSelector(child.url, lang) && "active"
                        }`}
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav-item">
                <a
                  href={slugSelector(menu.url, lang)}
                  class={`nav-link block ${
                    pathname === slugSelector(menu.url, lang) && "active"
                  }`}
                >
                  {menu.name}
                </a>
              </li>
            )}
          </>
        ))
      }
      {/* Navigation button */}
      {
        navigation_button.enable && (
          <li class="mt-4 inline-block lg:hidden">
            <a
              class="btn btn-outline-primary btn-sm"
              href={navigation_button.link}
              target={
                navigation_button.link.startsWith("http") ? "_blank" : "_self"
              }
              rel={navigation_button.link.startsWith("http") ? "noopener" : ""}
            >
              {get_started}
            </a>
          </li>
        )
      }
    </ul>

    <div class="order-1 ml-auto flex items-center md:order-2 lg:ml-0">
      {/* Search button */}
      {
        settings.search && (
          <button
            class="border-border text-text-dark hover:text-primary dark:border-darkmode-border mr-5 inline-block border-r pr-5 text-xl dark:text-white dark:hover:text-darkmode-primary"
            aria-label="search"
            data-search-trigger
          >
            <IoSearch />
          </button>
        )
      }
      {/* Theme switcher */}
      <ThemeSwitcher className="mr-5" />

      {/* Language switcher */}
      <LanguageSwitcher client:load lang={lang} pathname={pathname} translationPaths={translationPaths} />

      {/* Navigation button */}
      {
        navigation_button.enable && (
          <a
            class="btn btn-outline-primary btn-sm hidden lg:inline-block"
            href={navigation_button.link}
            target={
              navigation_button.link.startsWith("http") ? "_blank" : "_self"
            }
            rel={navigation_button.link.startsWith("http") ? "noopener" : ""}
          >
            {get_started}
          </a>
        )
      }
    </div>
  </nav>
</header>

<noscript>
  <style is:inline>
    /* without JS the toggle buttons do nothing: show the menu expanded on small screens, keep hover on large ones */
    @media (max-width: 63.999rem) {
      #nav-toggle { display: none; }
      #nav-menu, .nav-dropdown-list { display: block; }
    }
    @media (min-width: 64rem) {
      .nav-dropdown:hover > .nav-dropdown-list,
      .nav-dropdown:focus-within > .nav-dropdown-list { visibility: visible; opacity: 1; }
    }
  </style>
</noscript>

<script>
  // Menu and submenu state live in aria-expanded; CSS reads it (safe.css). Escape closes and returns focus.
  // Bound now and again on astro:page-load, because the client router replaces the header on navigation
  // (the first page-load event can fire before this module runs; data-bound keeps bindings single).
  function setExpanded(button: Element, open: boolean) {
    button.setAttribute("aria-expanded", String(open));
  }
  function bind() {
    const toggle = document.getElementById("nav-toggle");
    if (!toggle || toggle.dataset.bound) return;
    toggle.dataset.bound = "true";
    toggle.addEventListener("click", () =>
      setExpanded(toggle, toggle.getAttribute("aria-expanded") !== "true"),
    );
    document.querySelectorAll("[data-submenu-toggle]").forEach((button) => {
      button.addEventListener("click", () =>
        setExpanded(button, button.getAttribute("aria-expanded") !== "true"),
      );
    });
    document.querySelectorAll(".nav-dropdown").forEach((item) => {
      const button = item.querySelector("[data-submenu-toggle]");
      if (!button) return;
      item.addEventListener("pointerenter", (event) => {
        if ((event as PointerEvent).pointerType === "mouse" && matchMedia("(min-width: 64rem)").matches) {
          setExpanded(button, true);
        }
      });
      item.addEventListener("pointerleave", () => {
        if (!item.contains(document.activeElement)) setExpanded(button, false);
      });
      item.addEventListener("focusout", (event) => {
        const next = (event as FocusEvent).relatedTarget as Node | null;
        if (next && !item.contains(next)) setExpanded(button, false);
      });
    });
  }
  bind();
  document.addEventListener("astro:page-load", bind);
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const open =
      document.querySelector<HTMLElement>("[data-submenu-toggle][aria-expanded=true]") ??
      document.querySelector<HTMLElement>("#nav-toggle[aria-expanded=true]");
    if (!open) return;
    setExpanded(open, false);
    if (document.getElementById("nav-menu")?.contains(document.activeElement) || document.activeElement === open) open.focus();
  });
</script>
