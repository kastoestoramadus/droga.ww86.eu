---
import BlogCard from "@/components/BlogCard.astro";
import ImageMod from "@/components/ImageMod.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { selectHomePosts } from "@/lib/homePosts";
import {
  getLangFromUrl,
  getTranslations,
  slugSelector,
  supportedLang,
} from "@/lib/utils/languageParser";
import { markdownify } from "@/lib/utils/textConverter";

export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

const { lang } = Astro.params;
const homepage = await getListPage("homepage", lang);
const { banner } = homepage[0].data;

const buildDrafts = process.argv.includes("--buildDrafts");
const buildFuture = process.argv.includes("--buildFuture");
const posts = await getSinglePage("blog", lang);
const home = selectHomePosts(posts, config.settings.home_posts, new Date(), {
  drafts: buildDrafts,
  future: buildFuture,
});

const uiLang = getLangFromUrl(Astro.url);
const { all_posts } = await getTranslations(uiLang);
---

<Base>
  <!-- Banner -->
  <section class="section pt-10 pb-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-9 mb-6 text-center">
          <h1
            set:html={markdownify(banner.title)}
            class="mb-2 text-h3 lg:text-h2"
          />
          <p set:html={markdownify(banner.content)} class="mb-6" />
        </div>
        {
          banner.image && (
            <div class="col-12">
              <ImageMod
                src={banner.image}
                height={380}
                width={1200}
                alt="banner"
                format="webp"
                class="mx-auto w-full"
              />
            </div>
          )
        }
      </div>
    </div>
  </section>
  <!-- /Banner -->

  <!-- Latest posts -->
  <section class="section pt-8">
    <div class="container">
      <div class="row gx-5">
        {
          home.posts.map((post) => (
            <div class="mb-14 md:col-6">
              <BlogCard data={post} />
            </div>
          ))
        }
      </div>
      {
        home.showAll && (
          <div class="text-center">
            <a class="btn btn-outline-primary" href={slugSelector("/blog", uiLang)}>
              {all_posts}
            </a>
          </div>
        )
      }
    </div>
  </section>
  <!-- /Latest posts -->
</Base>
