---
import config from "@/config/config.json";
import AuthorRedirect from "@/layouts/partials/AuthorRedirect.astro";
import { supportedLang } from "@/lib/utils/languageParser";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({ params: { lang: lang || undefined } }));
}

const { lang } = Astro.params;
const code = lang || config.settings.default_language;
const target = code === config.settings.default_language ? "/about" : `/${code}/about`;
const title = code === config.settings.default_language ? "Autorzy" : "Authors";
---

<AuthorRedirect lang={code} target={target} title={title} />
